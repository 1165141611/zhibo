<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="直播遥控 · 悬浮控制台"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingTop="24dp"
        android:paddingBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="电脑IP:端口(电脑后台窗口打印的那个地址)"
        android:textSize="13sp"
        android:paddingBottom="6dp" />

    <EditText
        android:id="@+id/ipInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="例如 192.168.1.5:8765"
        android:inputType="textNoSuggestions"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/startBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="启动悬浮控制台" />

    <Button
        android:id="@+id/stopBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="停止悬浮控制台" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="首次启动会跳到系统设置要求授予“显示在其他应用上层”权限;授权后返回本页再点一次“启动”。之后每次打开 App,只要能连上电脑后端就会自动进入悬浮态,无需再点启动。悬浮窗出现后,拖顶部灰条移动位置,拖到 scrcpy 歌词裁剪框以外即可不入镜。“—”收起成悬浮球(可拖动,点一下重新展开),“×”关闭。"
        android:textSize="12sp"
        android:textColor="#888888"
        android:paddingTop="24dp" />
</LinearLayout>
